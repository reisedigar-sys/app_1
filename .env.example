# Copie para .env.local. Os valores abaixo são os padrões do Supabase local (pnpm db:start).
# Para ver todos: pnpm exec supabase status -o env

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Só servidor (ignora o RLS). Nunca use prefixo NEXT_PUBLIC_ nem importe no navegador.
# Local: valor SECRET_KEY de `supabase status -o env`.
SUPABASE_SECRET_KEY=

# Conexão direta ao Postgres, usada pelos testes.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Push (semana 7): chave pública VAPID do ambiente (pnpm vapid:gerar). Sem ela, a tela de avisos no celular fica
# indisponível. A chave privada fica só nos segredos da Edge Function `notificacoes`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
